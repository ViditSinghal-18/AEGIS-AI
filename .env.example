# ==============================================================================
# AEGIS-AI Environment Configuration Example
# Copy to .env for local configuration: cp .env.example .env
# Never commit .env with real secrets to version control.
# ==============================================================================

# Server Runtime
AEGIS_ENV=development
AEGIS_DEBUG=false
PORT=5000
HOST=127.0.0.1
SECRET_KEY=aegis-defense-secret-key-replace-in-production

# Optional API Access Token (if set, required as 'X-Aegis-Token' or 'Authorization: Bearer <token>')
AEGIS_API_TOKEN=

# Threat Intelligence API Keys (Optional)
# NVD API Key increases rate limits from 5 requests/30s to 50 requests/30s
NVD_API_KEY=

# ==============================================================================
# LLM Provider (AEGIS-AI Provider-Neutral Layer)
# Set AEGIS_LLM_PROVIDER to: none (default) | openai_compatible | ollama | bedrock
# Default is 'none': zero LLM calls; dashboard and triage run on heuristics only.
# ==============================================================================
AEGIS_LLM_PROVIDER=none

# --- Option 1: Groq (FREE, fast, recommended) ---
# AEGIS_LLM_PROVIDER=openai_compatible
# AEGIS_LLM_BASE_URL=https://api.groq.com/openai/v1
# AEGIS_LLM_API_KEY=gsk_your_groq_key_here
# AEGIS_LLM_MODEL=llama-3.1-8b-instant
# AEGIS_LLM_MODEL_LARGE=llama-3.3-70b-versatile

# --- Option 2: Cerebras (FREE) ---
# AEGIS_LLM_PROVIDER=openai_compatible
# AEGIS_LLM_BASE_URL=https://api.cerebras.ai/v1
# AEGIS_LLM_API_KEY=your_cerebras_key
# AEGIS_LLM_MODEL=llama3.1-8b

# --- Option 3: OpenRouter ":free" models ---
# AEGIS_LLM_PROVIDER=openai_compatible
# AEGIS_LLM_BASE_URL=https://openrouter.ai/api/v1
# AEGIS_LLM_API_KEY=your_openrouter_key
# AEGIS_LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Option 4: Gemini (OpenAI-compatible endpoint) ---
# WARNING: Gemini's free tier may use prompts to train Google models.
# AEGIS_LLM_PROVIDER=openai_compatible
# AEGIS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AEGIS_LLM_API_KEY=your_gemini_api_key
# AEGIS_LLM_MODEL=gemini-2.0-flash

# --- Option 5: Local Ollama (air-gapped / local) ---
# AEGIS_LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# AEGIS_LLM_MODEL=llama3.2

# --- Option 6: Amazon Bedrock (OPTIONAL - requires AWS credentials) ---
# AEGIS_LLM_PROVIDER=bedrock
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=us-east-1
# BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# BEDROCK_SMALL_MODEL=amazon.nova-micro-v1:0
# BEDROCK_LARGE_MODEL=amazon.nova-pro-v1:0

# Storage & Persistence
# Options: 'file' (default, uses data/ locally or /tmp on Vercel), 'memory'
AEGIS_STORAGE_BACKEND=file

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_TARGET_PER_MINUTE=4
CORS_ORIGIN=*
